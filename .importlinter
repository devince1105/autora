# Python layer boundaries (logs/3d-office/08_REPOSITORY_STRUCTURE.md §3). Run: make lint-imports
#
# Higher layers may import lower ones, never the reverse. `a | b` = same layer, independent.

[importlinter]
root_package = autora
include_external_packages = True

[importlinter:contract:layers]
name = Autora layers: app > accounts|domains|realtime > company > runtime > db > infra
type = layers
layers =
    autora.app
    autora.accounts | autora.domains | autora.realtime
    autora.company
    autora.runtime
    autora.db
    autora.infra
# Alembic's env must see every table, including domain tables; it asks the composition root.
ignore_imports =
    autora.db.migrations.env -> autora.app

[importlinter:contract:runtime-no-http]
name = Runtime and company never depend on the web framework
type = forbidden
source_modules =
    autora.runtime
    autora.company
    autora.db
forbidden_modules =
    fastapi
    starlette
# D-025: a reader's address lives in autora.accounts and nowhere else. The layers contract
# already stops anything below from importing it; this one says why, so that removing the line
# has to be a decision somebody makes on purpose.
[importlinter:contract:no-one-reads-the-readers]
name = No agent, domain or company code may read a reader's identity
type = forbidden
source_modules =
    autora.company
    autora.domains
    autora.runtime
    autora.db
forbidden_modules =
    autora.accounts
# The same exception the layers contract makes: migrations ask the composition root for every
# table, and readers are tables too. It reaches accounts through app, not around this line.
ignore_imports =
    autora.db.migrations.env -> autora.app

# Domain independence (domains never import each other) is added with the second domain.
