# Copy to .env and fill in. Never commit .env.

# --- Database (host port is 5434 to avoid clashing with other local Postgres) ---
AUTORA_DB_PORT=5434
DATABASE_URL=postgresql+asyncpg://autora:autora@localhost:5434/autora

# --- Model provider (T-207/T-208, D-005). Model ids live here, never in code. ---
# fake: simulated, free (default).  nvidia: NVIDIA Build, glm-5.3-flash (D-005/D-006).  anthropic: Claude API.
# Both API keys may stay filled in; switching = change MODEL_PROVIDER and the two model ids.
MODEL_PROVIDER=fake
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=180         # per request; on timeout the FAST model is tried at once
ANTHROPIC_API_KEY=
FRONTIER_MODEL_ID=
FAST_MODEL_ID=
# USD per million tokens for every model id you use (JSON, one line). Required with a real
# provider. NVIDIA free endpoints cost 0; list every model you may switch to.
MODEL_PRICES={}
ANTHROPIC_SERVER_FALLBACKS=true   # fallbacks:"default" on refusals (beta server-side-fallback-2026-07-01)

# NVIDIA (D-005):
#   MODEL_PROVIDER=nvidia
#   FRONTIER_MODEL_ID=z-ai/glm-5.3-flash
#   FAST_MODEL_ID=
#   MODEL_PRICES={"z-ai/glm-5.3-flash":{"input":0,"output":0}}
#   (z-ai/glm-5.3 is more capable but took minutes per reply on the free endpoint; D-006)
# Anthropic:
#   MODEL_PROVIDER=anthropic
#   FRONTIER_MODEL_ID=claude-opus-5
#   FAST_MODEL_ID=claude-sonnet-5
#   (add both ids to MODEL_PRICES with the prices from Anthropic's pricing page)

# --- Tools (T-500, D-003) ---
TOOLS_PROFILE=fixture          # fixture | live (live needs TAVILY_API_KEY)
TAVILY_API_KEY=
# TAVILY_SEARCH_DEPTH=basic      # basic (1 credit per search) | advanced (2 credits)
# TAVILY_COST_PER_CREDIT=0.008   # USD, recorded as each search's cost
# TAVILY_TIMEOUT_SECONDS=15
# TAVILY_REQUESTS_PER_MINUTE=60

# --- Worker (T-213) ---
# WORKER_ID=                      # default: <hostname>-<pid>
WORKER_CONCURRENCY=4              # agent runs at once per worker process
WORKER_POLL_SECONDS=1
WORKER_MAINTENANCE_SECONDS=15     # reap expired leases, expire approvals, fire schedules
WORKER_COMPANY_IDS=[]             # JSON list; empty = every company
TASK_LEASE_SECONDS=300
TASK_RETRY_BASE_SECONDS=10

# --- API ---
API_BEARER_TOKEN=change-me
CORS_ORIGINS=["http://localhost:3000"]   # browser origins allowed to call the API

# --- Blob storage (T-210). Default: <repo>/data/blobs (gitignored) ---
# BLOB_STORE_DIR=/var/lib/autora/blobs
