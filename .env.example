# Copy to .env and fill in. Never commit .env.

# --- Database (host port is 5434 to avoid clashing with other local Postgres) ---
AUTORA_DB_PORT=5434
DATABASE_URL=postgresql+asyncpg://autora:autora@localhost:5434/autora

# --- Model provider (T-207/T-208, D-005). Model ids live here, never in code. ---
# fake: simulated, free (default).  nvidia: NVIDIA Build, glm-5.3-flash (D-005/D-006).  anthropic: Claude API.
# Both API keys may stay filled in; switching = change MODEL_PROVIDER and the two model ids.
MODEL_PROVIDER=fake
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=180         # per request; on timeout the FAST model is tried at once
ANTHROPIC_API_KEY=
FRONTIER_MODEL_ID=
FAST_MODEL_ID=
# USD per million tokens for every model id you use (JSON, one line). Required with a real
# provider. NVIDIA free endpoints cost 0; list every model you may switch to.
MODEL_PRICES={}
ANTHROPIC_SERVER_FALLBACKS=true   # fallbacks:"default" on refusals (beta server-side-fallback-2026-07-01)

# Money (D-023). The ledger, budgets and reports are kept in BASE_CURRENCY; model and tool
# costs are metered in USD and converted at FX_RATES (base units per 1 unit), set by hand.
BASE_CURRENCY=TWD
FX_RATES={"USD":"32"}

# NVIDIA (D-005):
#   MODEL_PROVIDER=nvidia
#   FRONTIER_MODEL_ID=z-ai/glm-5.3-flash
#   FAST_MODEL_ID=
#   MODEL_PRICES={"z-ai/glm-5.3-flash":{"input":0,"output":0}}
#   (z-ai/glm-5.3 is more capable but took minutes per reply on the free endpoint; D-006)
# Anthropic:
#   MODEL_PROVIDER=anthropic
#   FRONTIER_MODEL_ID=claude-opus-5
#   FAST_MODEL_ID=claude-sonnet-5
#   (add both ids to MODEL_PRICES with the prices from Anthropic's pricing page)

# --- Embeddings (T-503): vectors for evidence search, separate from the agents' model ---
EMBED_PROVIDER=fake             # fake (offline hashing vectors) | nvidia
# EMBED_MODEL_ID=nvidia/nemotron-3-embed-1b   # required unless fake; must give 2048-dim vectors
# (price it in MODEL_PRICES with an "input" entry; unpriced means free)

# --- Tools (T-500, D-003) ---
TOOLS_PROFILE=fixture          # fixture | live (live needs TAVILY_API_KEY)
TAVILY_API_KEY=
# TAVILY_SEARCH_DEPTH=basic      # basic (1 credit per search) | advanced (2 credits)
# TAVILY_COST_PER_CREDIT=0.008   # USD, recorded as each search's cost
# TAVILY_TIMEOUT_SECONDS=15
# TAVILY_REQUESTS_PER_MINUTE=60
# FETCH_TIMEOUT_SECONDS=15       # live page / feed fetches (T-501, T-502)
# FETCH_MAX_BYTES=5000000

# --- Worker (T-213) ---
# WORKER_ID=                      # default: <hostname>-<pid>
WORKER_CONCURRENCY=4              # agent runs at once per worker process
WORKER_POLL_SECONDS=1
WORKER_MAINTENANCE_SECONDS=15     # reap expired leases, expire approvals, fire schedules
WORKER_COMPANY_IDS=[]             # JSON list; empty = every company
TASK_LEASE_SECONDS=300
TASK_RETRY_BASE_SECONDS=10

# --- API ---
API_BEARER_TOKEN=change-me
CORS_ORIGINS=["http://localhost:3000"]   # browser origins allowed to call the API

# --- Blob storage (T-210). Default: <repo>/data/blobs (gitignored) ---
# BLOB_STORE_DIR=/var/lib/autora/blobs

# --- Payments: PAYUNi 統一金流 (D-024) ---
# Sandbox store: https://sandbox.payuni.com.tw/ ; ids in 會員中心 > 商店列表 > 整合設定.
PAYUNI_ENV=sandbox                # sandbox | production
PAYUNI_MER_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
PAYUNI_RETURN_URL=http://localhost:3000/news/zh-TW/membership/return
PAYUNI_NOTIFY_URL=http://localhost:8000/api/payments/payuni/notify

# --- Email: Resend (D-025) ---
EMAIL_PROVIDER=console            # console: print the email (dev, tests). resend: really send.
RESEND_API_KEY=
EMAIL_FROM=Autora <onboarding@resend.dev>
SITE_BASE_URL=http://localhost:3000

# Which company the public site belongs to (D-025). Both are the same slug: the server uses
# SITE_COMPANY for the article list, the browser NEXT_PUBLIC_SITE_COMPANY for the member badge.
SITE_COMPANY=
NEXT_PUBLIC_SITE_COMPANY=

# Who runs the site, for the footer and the policies (D-034). Read by `next build`, like the two
# above (the Docker build takes them as build args). Empty ones are left off the page. The owner
# and the phone are a person's; keep them in .env, never in the repository.
SITE_OPERATOR=Nanguado
SITE_OPERATOR_OWNER=
SITE_CONTACT_EMAIL=service@nanguado.com
SITE_CONTACT_PHONE=
