# Copy to .env and fill in. Never commit .env.

# --- Database (host port is 5434 to avoid clashing with other local Postgres) ---
AUTORA_DB_PORT=5434
DATABASE_URL=postgresql+asyncpg://autora:autora@localhost:5434/autora

# --- Model provider (T-207/T-208). Model ids live here, never in code. ---
MODEL_PROVIDER=fake            # fake | anthropic
ANTHROPIC_API_KEY=
FRONTIER_MODEL_ID=
FAST_MODEL_ID=
# USD per million tokens for every configured model id (JSON). Required with anthropic.
# MODEL_PRICES={"<frontier id>":{"input":5,"output":25,"cache_read":0.5,"cache_write":6.25}}
MODEL_PRICES={}
ANTHROPIC_SERVER_FALLBACKS=true   # fallbacks:"default" on refusals (beta server-side-fallback-2026-07-01)

# --- Tools (T-500, D-003) ---
TOOLS_PROFILE=fixture          # fixture | live
TAVILY_API_KEY=

# --- API ---
API_BEARER_TOKEN=change-me

# --- Blob storage (T-210). Default: <repo>/data/blobs (gitignored) ---
# BLOB_STORE_DIR=/var/lib/autora/blobs
