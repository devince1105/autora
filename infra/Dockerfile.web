FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY frontend/web/package.json frontend/web/
COPY frontend/event-schema/package.json frontend/event-schema/
RUN pnpm install --frozen-lockfile

FROM deps AS build
# The public site's footer and policies are rendered at build time (D-034).
ARG SITE_OPERATOR SITE_OPERATOR_OWNER SITE_CONTACT_EMAIL SITE_CONTACT_PHONE
ENV SITE_OPERATOR=$SITE_OPERATOR SITE_OPERATOR_OWNER=$SITE_OPERATOR_OWNER \
    SITE_CONTACT_EMAIL=$SITE_CONTACT_EMAIL SITE_CONTACT_PHONE=$SITE_CONTACT_PHONE
COPY . .
RUN pnpm -F web build

FROM base AS run
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3000
CMD ["pnpm", "-F", "web", "start"]
