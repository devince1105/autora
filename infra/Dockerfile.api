FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY packages/autora /app/packages/autora
RUN pip install --no-cache-dir -e /app/packages/autora

COPY apps/api /app/apps/api

EXPOSE 8000
CMD ["uvicorn", "--app-dir", "apps/api", "main:app", "--host", "0.0.0.0", "--port", "8000"]
